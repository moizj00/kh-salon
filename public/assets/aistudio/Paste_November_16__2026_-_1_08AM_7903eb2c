  created_at_client timestamp with time zone,
  confirmed_at timestamp with time zone,
  cancelled_at timestamp with time zone,
  cancelled_by uuid,
  cancel_reason text CHECK (length(cancel_reason) <= 300),
  source_channel USER-DEFINED NOT NULL DEFAULT 'rep_visit'::order_channel,
  created_by uuid NOT NULL,
  assigned_rep_id uuid,
  intake_card_id uuid,
  discount_by_owner boolean NOT NULL DEFAULT false,
  CONSTRAINT sales_order_pkey PRIMARY KEY (id),
  CONSTRAINT sales_order_salon_id_fkey FOREIGN KEY (salon_id) REFERENCES public.salon(id),
  CONSTRAINT sales_order_rep_id_fkey FOREIGN KEY (rep_id) REFERENCES public.user_profile(id),
  CONSTRAINT sales_order_rep_day_id_fkey FOREIGN KEY (rep_day_id) REFERENCES public.rep_day(id),
  CONSTRAINT sales_order_visit_id_fkey FOREIGN KEY (visit_id) REFERENCES public.visit(id),
  CONSTRAINT sales_order_discount_approval_id_fkey FOREIGN KEY (discount_approval_id) REFERENCES control.approval_request(id),
  CONSTRAINT sales_order_credit_override_by_fkey FOREIGN KEY (credit_override_by) REFERENCES public.user_profile(id),
