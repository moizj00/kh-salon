CREATE TABLE public.sales_order (
  id uuid NOT NULL,
  client_id uuid NOT NULL UNIQUE,
  salon_id uuid NOT NULL,
  rep_id uuid,
  rep_day_id uuid,
  visit_id uuid,
  plan USER-DEFINED NOT NULL,
  delivery_mode USER-DEFINED NOT NULL,
  status USER-DEFINED NOT NULL DEFAULT 'draft'::order_status,
  subtotal_paisa bigint NOT NULL CHECK (subtotal_paisa > 0),
  discount_paisa bigint NOT NULL DEFAULT 0 CHECK (discount_paisa >= 0),
  total_paisa bigint NOT NULL,
