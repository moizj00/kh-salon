  counted_lines jsonb,
  decided_by uuid,
  decided_at timestamp with time zone,
  decision_note text CHECK (length(decision_note) <= 300),
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT stock_issue_pkey PRIMARY KEY (id),
  CONSTRAINT stock_issue_warehouse_id_fkey FOREIGN KEY (warehouse_id) REFERENCES public.stock_location(id),
  CONSTRAINT stock_issue_bag_id_fkey FOREIGN KEY (bag_id) REFERENCES public.stock_location(id),
  CONSTRAINT stock_issue_issued_by_fkey FOREIGN KEY (issued_by) REFERENCES public.user_profile(id),
  CONSTRAINT stock_issue_decided_by_fkey FOREIGN KEY (decided_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.stock_count (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  client_id uuid NOT NULL UNIQUE,
  location_id uuid NOT NULL,
  kind USER-DEFINED NOT NULL,
  counted_by uuid NOT NULL,
  lines jsonb NOT NULL,
  variance_units integer NOT NULL,
  counted_at_client timestamp with time zone,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT stock_count_pkey PRIMARY KEY (id),
  CONSTRAINT stock_count_location_id_fkey FOREIGN KEY (location_id) REFERENCES public.stock_location(id),
  CONSTRAINT stock_count_counted_by_fkey FOREIGN KEY (counted_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.reorder_rule (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  sku_id uuid NOT NULL UNIQUE,
  reorder_point integer NOT NULL CHECK (reorder_point >= 0),
  method text NOT NULL DEFAULT 'manual'::text CHECK (method = ANY (ARRAY['manual'::text, 'computed'::text])),
  updated_by uuid NOT NULL,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT reorder_rule_pkey PRIMARY KEY (id),
  CONSTRAINT reorder_rule_sku_id_fkey FOREIGN KEY (sku_id) REFERENCES public.sku(id),
  CONSTRAINT reorder_rule_updated_by_fkey FOREIGN KEY (updated_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.demand_signal (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  client_id uuid NOT NULL UNIQUE,
  sku_id uuid,
  product_group_id uuid,
  qty integer NOT NULL CHECK (qty >= 1 AND qty <= 100000),
  reason USER-DEFINED NOT NULL,
  source USER-DEFINED NOT NULL,
  outcome USER-DEFINED NOT NULL DEFAULT 'lost'::demand_outcome,
  salon_id uuid,
  location_id uuid,
  source_id uuid,
  captured_by uuid NOT NULL,
  captured_at_client timestamp with time zone,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT demand_signal_pkey PRIMARY KEY (id),
  CONSTRAINT demand_signal_sku_id_fkey FOREIGN KEY (sku_id) REFERENCES public.sku(id),
  CONSTRAINT demand_signal_product_group_id_fkey FOREIGN KEY (product_group_id) REFERENCES public.product_group(id),
  CONSTRAINT demand_signal_location_id_fkey FOREIGN KEY (location_id) REFERENCES public.stock_location(id),
  CONSTRAINT demand_signal_captured_by_fkey FOREIGN KEY (captured_by) REFERENCES public.user_profile(id),
  CONSTRAINT demand_signal_salon_fk FOREIGN KEY (salon_id) REFERENCES public.salon(id)
);
CREATE TABLE public.territory (
  id uuid NOT NULL,
  name text NOT NULL UNIQUE CHECK (length(btrim(name)) >= 2 AND length(btrim(name)) <= 80),
  active boolean NOT NULL DEFAULT true,
  created_by uuid NOT NULL,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT territory_pkey PRIMARY KEY (id),
  CONSTRAINT territory_created_by_fkey FOREIGN KEY (created_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.area (
  id uuid NOT NULL,
  territory_id uuid NOT NULL,
  name text NOT NULL CHECK (length(btrim(name)) >= 2 AND length(btrim(name)) <= 80),
  active boolean NOT NULL DEFAULT true,
  created_by uuid NOT NULL,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT area_pkey PRIMARY KEY (id),
  CONSTRAINT area_territory_id_fkey FOREIGN KEY (territory_id) REFERENCES public.territory(id),
  CONSTRAINT area_created_by_fkey FOREIGN KEY (created_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.rep_territory (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  rep_id uuid NOT NULL,
  territory_id uuid NOT NULL,
  from_date date NOT NULL DEFAULT ((now() AT TIME ZONE 'Asia/Karachi'::text))::date,
  to_date date,
  assigned_by uuid NOT NULL,
  ended_by uuid,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT rep_territory_pkey PRIMARY KEY (id),
  CONSTRAINT rep_territory_rep_id_fkey FOREIGN KEY (rep_id) REFERENCES public.user_profile(id),
  CONSTRAINT rep_territory_territory_id_fkey FOREIGN KEY (territory_id) REFERENCES public.territory(id),
  CONSTRAINT rep_territory_assigned_by_fkey FOREIGN KEY (assigned_by) REFERENCES public.user_profile(id),
  CONSTRAINT rep_territory_ended_by_fkey FOREIGN KEY (ended_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.salon (
  id uuid NOT NULL,
  name text CHECK (length(btrim(name)) >= 2 AND length(btrim(name)) <= 120),
  type USER-DEFINED NOT NULL,
  area_id uuid NOT NULL,
  address text CHECK (length(address) <= 300),
  lat numeric CHECK (lat >= '-90'::integer::numeric AND lat <= 90::numeric),
  lng numeric CHECK (lng >= '-180'::integer::numeric AND lng <= 180::numeric),
  chairs integer CHECK (chairs >= 0 AND chairs <= 200),
  stage USER-DEFINED NOT NULL DEFAULT 'prospect'::salon_stage,
  verification_status USER-DEFINED NOT NULL DEFAULT 'unverified'::salon_verification,
  source USER-DEFINED NOT NULL,
  place_id text CHECK (length(place_id) <= 300),
  discovered_by uuid,
  created_by uuid NOT NULL,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  created_at_client timestamp with time zone,
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  approval_status USER-DEFINED NOT NULL DEFAULT 'approved'::salon_approval,
  CONSTRAINT salon_pkey PRIMARY KEY (id),
  CONSTRAINT salon_area_id_fkey FOREIGN KEY (area_id) REFERENCES public.area(id),
  CONSTRAINT salon_discovered_by_fkey FOREIGN KEY (discovered_by) REFERENCES public.user_profile(id),
  CONSTRAINT salon_created_by_fkey FOREIGN KEY (created_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.salon_contact (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  salon_id uuid NOT NULL,
  name text CHECK (length(btrim(name)) >= 2 AND length(btrim(name)) <= 120),
  role text NOT NULL DEFAULT 'owner'::text CHECK (role = ANY (ARRAY['owner'::text, 'manager'::text, 'head_stylist'::text, 'other'::text])),
  phone text NOT NULL CHECK (phone ~ '^\+?[0-9]{10,15}$'::text),
  is_primary boolean NOT NULL DEFAULT true,
  whatsapp_opt_in boolean NOT NULL DEFAULT false,
  active boolean NOT NULL DEFAULT true,
  created_by uuid NOT NULL,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT salon_contact_pkey PRIMARY KEY (id),
  CONSTRAINT salon_contact_salon_id_fkey FOREIGN KEY (salon_id) REFERENCES public.salon(id),
  CONSTRAINT salon_contact_created_by_fkey FOREIGN KEY (created_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.salon_note (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  client_id uuid NOT NULL UNIQUE,
  salon_id uuid NOT NULL,
  author_id uuid NOT NULL,
  body text NOT NULL CHECK (length(btrim(body)) >= 1 AND length(btrim(body)) <= 1000),
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  created_at_client timestamp with time zone,
  CONSTRAINT salon_note_pkey PRIMARY KEY (id),
  CONSTRAINT salon_note_salon_id_fkey FOREIGN KEY (salon_id) REFERENCES public.salon(id),
  CONSTRAINT salon_note_author_id_fkey FOREIGN KEY (author_id) REFERENCES public.user_profile(id)
);
CREATE TABLE public.stage_event (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  salon_id uuid NOT NULL,
  from_stage USER-DEFINED,
  to_stage USER-DEFINED NOT NULL,
  trigger USER-DEFINED NOT NULL,
  reason text CHECK (length(reason) <= 300),
  actor_id uuid,
  tx_id bigint NOT NULL DEFAULT txid_current(),
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT stage_event_pkey PRIMARY KEY (id),
  CONSTRAINT stage_event_salon_id_fkey FOREIGN KEY (salon_id) REFERENCES public.salon(id),
  CONSTRAINT stage_event_actor_id_fkey FOREIGN KEY (actor_id) REFERENCES public.user_profile(id)
);
CREATE TABLE public.rep_day (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  rep_id uuid NOT NULL,
  day date NOT NULL,
  status USER-DEFINED NOT NULL DEFAULT 'open'::rep_day_status,
  check_in_at timestamp with time zone NOT NULL DEFAULT now(),
  check_in_at_client timestamp with time zone,
  check_in_lat numeric CHECK (check_in_lat >= '-90'::integer::numeric AND check_in_lat <= 90::numeric),
  check_in_lng numeric CHECK (check_in_lng >= '-180'::integer::numeric AND check_in_lng <= 180::numeric),
  bag_lines jsonb NOT NULL DEFAULT '[]'::jsonb,
  bag_variance_units integer NOT NULL DEFAULT 0,
  check_out_at timestamp with time zone,
  check_out_at_client timestamp with time zone,
  closed_by uuid,
  close_reason text CHECK (length(close_reason) <= 300),
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT rep_day_pkey PRIMARY KEY (id),
  CONSTRAINT rep_day_rep_id_fkey FOREIGN KEY (rep_id) REFERENCES public.user_profile(id),
  CONSTRAINT rep_day_closed_by_fkey FOREIGN KEY (closed_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.visit (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  client_id uuid NOT NULL UNIQUE,
  rep_day_id uuid NOT NULL,
  rep_id uuid NOT NULL,
  salon_id uuid NOT NULL,
  outcome USER-DEFINED NOT NULL,
  arrived_at timestamp with time zone NOT NULL DEFAULT now(),
  arrived_at_client timestamp with time zone,
  lat numeric NOT NULL CHECK (lat >= '-90'::integer::numeric AND lat <= 90::numeric),
  lng numeric NOT NULL CHECK (lng >= '-180'::integer::numeric AND lng <= 180::numeric),
  distance_from_pin_m integer CHECK (distance_from_pin_m >= 0),
  mock_location boolean NOT NULL DEFAULT false,
  notes text CHECK (length(notes) <= 500),
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT visit_pkey PRIMARY KEY (id),
  CONSTRAINT visit_rep_day_id_fkey FOREIGN KEY (rep_day_id) REFERENCES public.rep_day(id),
  CONSTRAINT visit_rep_id_fkey FOREIGN KEY (rep_id) REFERENCES public.user_profile(id),
  CONSTRAINT visit_salon_id_fkey FOREIGN KEY (salon_id) REFERENCES public.salon(id)
);
CREATE TABLE public.cycle_estimate (
  salon_id uuid NOT NULL,
  product_group_id uuid NOT NULL,
  last_order_on date NOT NULL,
  cycle_days integer CHECK (cycle_days >= 1 AND cycle_days <= 365),
  basis USER-DEFINED NOT NULL DEFAULT 'opening'::cycle_basis,
  basis_orders integer NOT NULL DEFAULT 0 CHECK (basis_orders >= 0),
  set_by uuid NOT NULL,
  set_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT cycle_estimate_pkey PRIMARY KEY (salon_id, product_group_id),
  CONSTRAINT cycle_estimate_salon_id_fkey FOREIGN KEY (salon_id) REFERENCES public.salon(id),
  CONSTRAINT cycle_estimate_product_group_id_fkey FOREIGN KEY (product_group_id) REFERENCES public.product_group(id),
  CONSTRAINT cycle_estimate_set_by_fkey FOREIGN KEY (set_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.route (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  rep_id uuid NOT NULL,
  day date NOT NULL,
  generated_by USER-DEFINED NOT NULL,
  created_by uuid NOT NULL,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT route_pkey PRIMARY KEY (id),
  CONSTRAINT route_rep_id_fkey FOREIGN KEY (rep_id) REFERENCES public.user_profile(id),
  CONSTRAINT route_created_by_fkey FOREIGN KEY (created_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.route_stop (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  route_id uuid NOT NULL,
  sequence integer NOT NULL CHECK (sequence >= 1 AND sequence <= 50),
  salon_id uuid NOT NULL,
  reason USER-DEFINED NOT NULL,
  added_by uuid NOT NULL,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT route_stop_pkey PRIMARY KEY (id),
  CONSTRAINT route_stop_route_id_fkey FOREIGN KEY (route_id) REFERENCES public.route(id),
  CONSTRAINT route_stop_salon_id_fkey FOREIGN KEY (salon_id) REFERENCES public.salon(id),
  CONSTRAINT route_stop_added_by_fkey FOREIGN KEY (added_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.salon_credit (
  salon_id uuid NOT NULL,
  plan_eligibility USER-DEFINED NOT NULL DEFAULT 'CASH'::plan_code,
  credit_limit_paisa bigint NOT NULL DEFAULT 0 CHECK (credit_limit_paisa >= 0),
  blocked boolean NOT NULL DEFAULT false,
  updated_by uuid NOT NULL,
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT salon_credit_pkey PRIMARY KEY (salon_id),
  CONSTRAINT salon_credit_salon_id_fkey FOREIGN KEY (salon_id) REFERENCES public.salon(id),
  CONSTRAINT salon_credit_updated_by_fkey FOREIGN KEY (updated_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.credit_event (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  salon_id uuid NOT NULL,
  kind USER-DEFINED NOT NULL,
  old_plan USER-DEFINED,
  new_plan USER-DEFINED NOT NULL,
  old_limit_paisa bigint,
  new_limit_paisa bigint NOT NULL CHECK (new_limit_paisa >= 0),
