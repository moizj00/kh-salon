  id uuid NOT NULL DEFAULT gen_random_uuid(),
  client_id uuid NOT NULL UNIQUE,
  submission_id uuid NOT NULL UNIQUE,
  outcome text NOT NULL CHECK (outcome = ANY (ARRAY['approved'::text, 'rejected'::text])),
  delivery_id uuid UNIQUE,
  reason text,
  decided_by uuid NOT NULL,
  decided_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT delivery_submission_decision_pkey PRIMARY KEY (id),
  CONSTRAINT delivery_submission_decision_decided_by_fkey FOREIGN KEY (decided_by) REFERENCES public.user_profile(id),
  CONSTRAINT delivery_submission_decision_delivery_id_fkey FOREIGN KEY (delivery_id) REFERENCES public.delivery(id),
  CONSTRAINT delivery_submission_decision_submission_id_fkey FOREIGN KEY (submission_id) REFERENCES public.delivery_submission(id)
);
CREATE TABLE public.pending_stock_resolution (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  client_id uuid NOT NULL UNIQUE,
  submission_id uuid NOT NULL,
  sku_id uuid NOT NULL,
  qty integer NOT NULL CHECK (qty > 0),
  outcome text NOT NULL CHECK (outcome = ANY (ARRAY['returned_to_bag'::text, 'returned_to_warehouse'::text, 'missing'::text])),
  note text NOT NULL CHECK (length(btrim(note)) >= 3 AND length(btrim(note)) <= 300),
  movement_id uuid NOT NULL UNIQUE,
  approval_id uuid,
  resolved_by uuid NOT NULL,
  resolved_at timestamp with time zone NOT NULL DEFAULT now(),
  owner_adjustment_id uuid,
  CONSTRAINT pending_stock_resolution_pkey PRIMARY KEY (id),
  CONSTRAINT pending_stock_resolution_submission_id_fkey FOREIGN KEY (submission_id) REFERENCES public.delivery_submission(id),
  CONSTRAINT pending_stock_resolution_sku_id_fkey FOREIGN KEY (sku_id) REFERENCES public.sku(id),
  CONSTRAINT pending_stock_resolution_movement_id_fkey FOREIGN KEY (movement_id) REFERENCES public.stock_movement(id),
  CONSTRAINT pending_stock_resolution_approval_id_fkey FOREIGN KEY (approval_id) REFERENCES control.approval_request(id),
  CONSTRAINT pending_stock_resolution_resolved_by_fkey FOREIGN KEY (resolved_by) REFERENCES public.user_profile(id),
  CONSTRAINT pending_stock_resolution_owner_adjustment_id_fkey FOREIGN KEY (owner_adjustment_id) REFERENCES public.owner_stock_adjustment(id)
);
CREATE TABLE public.rep_commission_rate (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  seq bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  client_id uuid NOT NULL UNIQUE,
  rep_id uuid NOT NULL,
  rate_bp integer NOT NULL CHECK (rate_bp >= 0 AND rate_bp <= 10000),
  reason text NOT NULL CHECK (length(btrim(reason)) >= 5 AND length(btrim(reason)) <= 300),
  set_by uuid NOT NULL,
  set_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT rep_commission_rate_pkey PRIMARY KEY (id),
  CONSTRAINT rep_commission_rate_rep_id_fkey FOREIGN KEY (rep_id) REFERENCES public.user_profile(id),
  CONSTRAINT rep_commission_rate_set_by_fkey FOREIGN KEY (set_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.commission_payment (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  client_id uuid NOT NULL UNIQUE,
  rep_id uuid NOT NULL,
  kind text NOT NULL CHECK (kind = ANY (ARRAY['payment'::text, 'reversal'::text])),
  amount_paisa bigint NOT NULL CHECK (amount_paisa > 0),
  reverses_id uuid UNIQUE,
  note text CHECK (length(note) <= 300),
  reason text,
  recorded_by uuid NOT NULL,
  recorded_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT commission_payment_pkey PRIMARY KEY (id),
  CONSTRAINT commission_payment_rep_id_fkey FOREIGN KEY (rep_id) REFERENCES public.user_profile(id),
  CONSTRAINT commission_payment_reverses_id_fkey FOREIGN KEY (reverses_id) REFERENCES public.commission_payment(id),
  CONSTRAINT commission_payment_recorded_by_fkey FOREIGN KEY (recorded_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.order_intake_card_version (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  client_id uuid NOT NULL UNIQUE,
  card_id uuid NOT NULL,
  version integer NOT NULL CHECK (version >= 2 AND version <= 51),
  body text CHECK (body IS NULL OR length(btrim(body)) >= 1 AND length(btrim(body)) <= 2000),
  edited_by uuid,
  edited_by_salon_user uuid,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT order_intake_card_version_pkey PRIMARY KEY (id),
  CONSTRAINT order_intake_card_version_card_id_fkey FOREIGN KEY (card_id) REFERENCES public.order_intake_card(id),
  CONSTRAINT order_intake_card_version_edited_by_fkey FOREIGN KEY (edited_by) REFERENCES public.user_profile(id),
  CONSTRAINT order_intake_card_version_edited_by_salon_user_fkey FOREIGN KEY (edited_by_salon_user) REFERENCES auth.users(id)
);
CREATE TABLE public.order_intake_card_line (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  card_id uuid NOT NULL,
  version integer NOT NULL CHECK (version >= 1 AND version <= 51),
  line_no integer NOT NULL CHECK (line_no >= 1 AND line_no <= 50),
  sku_id uuid NOT NULL,
  qty integer NOT NULL CHECK (qty >= 1 AND qty <= 10000),
  CONSTRAINT order_intake_card_line_pkey PRIMARY KEY (id),
  CONSTRAINT order_intake_card_line_card_id_fkey FOREIGN KEY (card_id) REFERENCES public.order_intake_card(id),
  CONSTRAINT order_intake_card_line_sku_id_fkey FOREIGN KEY (sku_id) REFERENCES public.sku(id)
);
CREATE TABLE public.invoice_draft_version (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  client_id uuid NOT NULL UNIQUE,
  order_id uuid NOT NULL,
  version integer NOT NULL CHECK (version >= 1),
  notes text CHECK (length(notes) <= 500),
  payment_instructions text CHECK (length(payment_instructions) <= 500),
  line_text jsonb NOT NULL DEFAULT '{}'::jsonb CHECK (jsonb_typeof(line_text) = 'object'::text),
  saved_by uuid NOT NULL,
  saved_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT invoice_draft_version_pkey PRIMARY KEY (id),
  CONSTRAINT invoice_draft_version_order_id_fkey FOREIGN KEY (order_id) REFERENCES public.sales_order(id),
  CONSTRAINT invoice_draft_version_saved_by_fkey FOREIGN KEY (saved_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.invoice_snapshot (
  id uuid NOT NULL DEFAULT gen_random_uuid() UNIQUE,
  invoice_id uuid NOT NULL,
  document jsonb NOT NULL,
  doc_hash text NOT NULL,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT invoice_snapshot_pkey PRIMARY KEY (invoice_id),
  CONSTRAINT invoice_snapshot_invoice_id_fkey FOREIGN KEY (invoice_id) REFERENCES public.invoice(id)
);
CREATE TABLE public.delivery_signature (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  client_id uuid NOT NULL UNIQUE,
  submission_id uuid,
  order_id uuid NOT NULL,
  salon_id uuid NOT NULL,
  rep_id uuid NOT NULL,
  device_hash text NOT NULL,
  outcome text NOT NULL CHECK (outcome = ANY (ARRAY['signed'::text, 'refused'::text, 'unable'::text])),
  signatory_name text CHECK (length(btrim(signatory_name)) >= 2 AND length(btrim(signatory_name)) <= 80),
  signatory_designation text CHECK (length(btrim(signatory_designation)) >= 2 AND length(btrim(signatory_designation)) <= 80),
  statement_version integer NOT NULL,
  statement_text text NOT NULL,
  lines_hash text NOT NULL,
  signature_size integer,
  signature_hash text,
  evidence_hash text NOT NULL,
  note text CHECK (length(btrim(note)) >= 5 AND length(btrim(note)) <= 300),
  signed_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT delivery_signature_pkey PRIMARY KEY (id),
  CONSTRAINT delivery_signature_submission_id_fkey FOREIGN KEY (submission_id) REFERENCES public.delivery_submission(id),
  CONSTRAINT delivery_signature_order_id_fkey FOREIGN KEY (order_id) REFERENCES public.sales_order(id),
  CONSTRAINT delivery_signature_salon_id_fkey FOREIGN KEY (salon_id) REFERENCES public.salon(id),
  CONSTRAINT delivery_signature_rep_id_fkey FOREIGN KEY (rep_id) REFERENCES public.user_profile(id)
);
CREATE TABLE public.delivery_signature_image (
  signature_id uuid NOT NULL,
  png bytea NOT NULL CHECK (length(png) >= 200 AND length(png) <= 120000),
  CONSTRAINT delivery_signature_image_pkey PRIMARY KEY (signature_id),
  CONSTRAINT delivery_signature_image_signature_id_fkey FOREIGN KEY (signature_id) REFERENCES public.delivery_signature(id)
);
CREATE TABLE public.delivery_signature_access (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  signature_id uuid NOT NULL,
  accessed_by uuid NOT NULL,
  accessed_at timestamp with time zone NOT NULL DEFAULT now(),
  purpose text NOT NULL CHECK (length(btrim(purpose)) >= 3 AND length(btrim(purpose)) <= 200),
  CONSTRAINT delivery_signature_access_pkey PRIMARY KEY (id),
  CONSTRAINT delivery_signature_access_signature_id_fkey FOREIGN KEY (signature_id) REFERENCES public.delivery_signature(id),
  CONSTRAINT delivery_signature_access_accessed_by_fkey FOREIGN KEY (accessed_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.delivery_signature_use (
  signature_id uuid NOT NULL,
  delivery_id uuid NOT NULL UNIQUE,
  used_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT delivery_signature_use_pkey PRIMARY KEY (signature_id),
  CONSTRAINT delivery_signature_use_signature_id_fkey FOREIGN KEY (signature_id) REFERENCES public.delivery_signature(id),
  CONSTRAINT delivery_signature_use_delivery_id_fkey FOREIGN KEY (delivery_id) REFERENCES public.delivery(id)
);
CREATE TABLE public.owner_stock_adjustment (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  client_id uuid NOT NULL UNIQUE,
  location_id uuid NOT NULL,
  sku_id uuid NOT NULL,
  qty_delta integer NOT NULL CHECK (qty_delta <> 0 AND qty_delta >= '-100000'::integer AND qty_delta <= 100000),
  reason text NOT NULL CHECK (length(btrim(reason)) >= 5 AND length(btrim(reason)) <= 300),
  submission_id uuid,
  owner_id uuid NOT NULL,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT owner_stock_adjustment_pkey PRIMARY KEY (id),
  CONSTRAINT owner_stock_adjustment_location_id_fkey FOREIGN KEY (location_id) REFERENCES public.stock_location(id),
  CONSTRAINT owner_stock_adjustment_sku_id_fkey FOREIGN KEY (sku_id) REFERENCES public.sku(id),
  CONSTRAINT owner_stock_adjustment_submission_id_fkey FOREIGN KEY (submission_id) REFERENCES public.delivery_submission(id),
  CONSTRAINT owner_stock_adjustment_owner_id_fkey FOREIGN KEY (owner_id) REFERENCES public.user_profile(id)
);
CREATE TABLE public.payment_reversal (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  client_id uuid NOT NULL UNIQUE,
  payment_id uuid NOT NULL UNIQUE,
  reason text NOT NULL CHECK (length(btrim(reason)) >= 5 AND length(btrim(reason)) <= 300),
  cash_holder text CHECK (cash_holder = ANY (ARRAY['rep'::text, 'office'::text])),
  reversed_by uuid NOT NULL,
  reversed_by_role USER-DEFINED NOT NULL CHECK (reversed_by_role = ANY (ARRAY['owner'::app_role, 'manager'::app_role])),
  reversed_at timestamp with time zone NOT NULL DEFAULT clock_timestamp(),
  CONSTRAINT payment_reversal_pkey PRIMARY KEY (id),
  CONSTRAINT payment_reversal_payment_id_fkey FOREIGN KEY (payment_id) REFERENCES public.payment(id),
  CONSTRAINT payment_reversal_reversed_by_fkey FOREIGN KEY (reversed_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.handover_settlement (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  client_id uuid NOT NULL UNIQUE,
  handover_id uuid NOT NULL UNIQUE,
  outcome text NOT NULL CHECK (outcome = ANY (ARRAY['counted'::text, 'rep'::text, 'withdrawn'::text])),
  reason text NOT NULL CHECK (length(btrim(reason)) >= 5 AND length(btrim(reason)) <= 300),
  settled_by uuid NOT NULL,
  settled_by_role USER-DEFINED NOT NULL CHECK (settled_by_role = ANY (ARRAY['owner'::app_role, 'manager'::app_role])),
  settled_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT handover_settlement_pkey PRIMARY KEY (id),
  CONSTRAINT handover_settlement_handover_id_fkey FOREIGN KEY (handover_id) REFERENCES public.handover(id),
  CONSTRAINT handover_settlement_settled_by_fkey FOREIGN KEY (settled_by) REFERENCES public.user_profile(id)
);