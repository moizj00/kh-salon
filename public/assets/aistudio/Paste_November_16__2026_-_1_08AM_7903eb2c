  tx_id bigint NOT NULL DEFAULT txid_current(),
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT credit_event_pkey PRIMARY KEY (id),
  CONSTRAINT credit_event_salon_id_fkey FOREIGN KEY (salon_id) REFERENCES public.salon(id),
  CONSTRAINT credit_event_actor_id_fkey FOREIGN KEY (actor_id) REFERENCES public.user_profile(id),
  CONSTRAINT credit_event_order_fk FOREIGN KEY (order_id) REFERENCES public.sales_order(id)
