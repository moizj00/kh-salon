-- WARNING: This schema is for context only and is not meant to be run.
-- Table order and constraints may not be valid for execution.

CREATE TABLE public.user_profile (
  id uuid NOT NULL,
  full_name text NOT NULL CHECK (length(btrim(full_name)) >= 2 AND length(btrim(full_name)) <= 120),
  role USER-DEFINED NOT NULL,
  phone text CHECK (phone ~ '^\+?[0-9]{10,15}$'::text),
  status USER-DEFINED NOT NULL DEFAULT 'active'::user_status,
  start_date date,
  commission_plan_id uuid,
  vault_grant boolean NOT NULL DEFAULT false,
  created_by uuid,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT user_profile_pkey PRIMARY KEY (id),
  CONSTRAINT user_profile_id_fkey FOREIGN KEY (id) REFERENCES auth.users(id),
  CONSTRAINT user_profile_created_by_fkey FOREIGN KEY (created_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.device (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  user_id uuid NOT NULL,
  device_fingerprint text NOT NULL CHECK (device_fingerprint ~ '^[0-9a-f]{64}$'::text),
  platform text CHECK (length(platform) <= 60),
  label text CHECK (length(label) <= 80),
  status USER-DEFINED NOT NULL DEFAULT 'pending'::device_status,
  approved_by uuid,
  approved_at timestamp with time zone,
  revoked_by uuid,
  revoked_at timestamp with time zone,
  last_seen_at timestamp with time zone,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT device_pkey PRIMARY KEY (id),
  CONSTRAINT device_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.user_profile(id),
  CONSTRAINT device_approved_by_fkey FOREIGN KEY (approved_by) REFERENCES public.user_profile(id),
  CONSTRAINT device_revoked_by_fkey FOREIGN KEY (revoked_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.app_config (
  key text NOT NULL CHECK (key ~ '^[a-z0-9_]+(\.[a-z0-9_]+)*$'::text),
  value jsonb NOT NULL,
  rep_visible boolean NOT NULL DEFAULT false,
  note text,
  updated_by uuid,
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT app_config_pkey PRIMARY KEY (key),
  CONSTRAINT app_config_updated_by_fkey FOREIGN KEY (updated_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.product_group (
  id uuid NOT NULL,
  name text NOT NULL UNIQUE CHECK (length(btrim(name)) >= 2 AND length(btrim(name)) <= 60),
  default_cycle_days integer NOT NULL CHECK (default_cycle_days >= 1 AND default_cycle_days <= 365),
  active boolean NOT NULL DEFAULT true,
  created_by uuid NOT NULL,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT product_group_pkey PRIMARY KEY (id),
  CONSTRAINT product_group_created_by_fkey FOREIGN KEY (created_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.product (
  id uuid NOT NULL,
  product_group_id uuid NOT NULL,
  brand_label text NOT NULL CHECK (length(btrim(brand_label)) >= 2 AND length(btrim(brand_label)) <= 60),
  name text NOT NULL CHECK (length(btrim(name)) >= 2 AND length(btrim(name)) <= 120),
  active boolean NOT NULL DEFAULT true,
  created_by uuid NOT NULL,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  description text CHECK (description IS NULL OR length(btrim(description)) >= 1 AND length(description) <= 1000),
  image_path text,
  CONSTRAINT product_pkey PRIMARY KEY (id),
  CONSTRAINT product_product_group_id_fkey FOREIGN KEY (product_group_id) REFERENCES public.product_group(id),
  CONSTRAINT product_created_by_fkey FOREIGN KEY (created_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.sku (
  id uuid NOT NULL,
  product_id uuid NOT NULL,
  code text NOT NULL UNIQUE CHECK (code ~ '^[A-Z0-9][A-Z0-9-]{1,39}$'::text),
  variant text NOT NULL CHECK (length(btrim(variant)) >= 1 AND length(btrim(variant)) <= 80),
  unit text NOT NULL CHECK (unit = ANY (ARRAY['ml'::text, 'l'::text, 'g'::text, 'kg'::text, 'pack'::text, 'piece'::text])),
  size_value numeric CHECK (size_value > 0::numeric),
  units_per_carton integer CHECK (units_per_carton > 0),
  barcode text UNIQUE CHECK (barcode ~ '^[0-9A-Za-z-]{4,32}$'::text),
  list_price_paisa bigint CHECK (list_price_paisa > 0),
  active boolean NOT NULL DEFAULT true,
  created_by uuid NOT NULL,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT sku_pkey PRIMARY KEY (id),
  CONSTRAINT sku_product_id_fkey FOREIGN KEY (product_id) REFERENCES public.product(id),
  CONSTRAINT sku_created_by_fkey FOREIGN KEY (created_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.stock_location (
  id uuid NOT NULL,
  kind USER-DEFINED NOT NULL,
  name text NOT NULL CHECK (length(btrim(name)) >= 2 AND length(btrim(name)) <= 80),
  owner_user_id uuid,
  bag_value_limit_paisa bigint CHECK (bag_value_limit_paisa >= 0),
  active boolean NOT NULL DEFAULT true,
  created_by uuid NOT NULL,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT stock_location_pkey PRIMARY KEY (id),
  CONSTRAINT stock_location_owner_user_id_fkey FOREIGN KEY (owner_user_id) REFERENCES public.user_profile(id),
  CONSTRAINT stock_location_created_by_fkey FOREIGN KEY (created_by) REFERENCES public.user_profile(id)
);
CREATE TABLE public.stock_movement (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  client_id uuid NOT NULL UNIQUE,
  sku_id uuid NOT NULL,
  qty integer NOT NULL CHECK (qty > 0),
  from_location_id uuid,
  to_location_id uuid,
  kind USER-DEFINED NOT NULL,
  source_type text CHECK (source_type ~ '^[a-z_]+$'::text),
  source_id uuid,
  approval_id uuid,
  reason text CHECK (length(reason) <= 300),
  actor_id uuid NOT NULL,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT stock_movement_pkey PRIMARY KEY (id),
  CONSTRAINT stock_movement_sku_id_fkey FOREIGN KEY (sku_id) REFERENCES public.sku(id),
  CONSTRAINT stock_movement_from_location_id_fkey FOREIGN KEY (from_location_id) REFERENCES public.stock_location(id),
  CONSTRAINT stock_movement_to_location_id_fkey FOREIGN KEY (to_location_id) REFERENCES public.stock_location(id),
  CONSTRAINT stock_movement_approval_id_fkey FOREIGN KEY (approval_id) REFERENCES control.approval_request(id),
  CONSTRAINT stock_movement_actor_id_fkey FOREIGN KEY (actor_id) REFERENCES public.user_profile(id)
);
CREATE TABLE public.stock_issue (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  client_id uuid NOT NULL UNIQUE,
  direction USER-DEFINED NOT NULL,
  warehouse_id uuid NOT NULL,
  bag_id uuid NOT NULL,
  lines jsonb NOT NULL CHECK (jsonb_typeof(lines) = 'array'::text AND jsonb_array_length(lines) > 0),
  route_date date,
  suggestion jsonb,
  issued_by uuid NOT NULL,
